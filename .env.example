# GammaSummit environment template (card E1.1).
# Copy to .env and fill in real values. NEVER commit .env (gitignored).
# Placeholders only in this file — every value stays empty, every key is
# GAMMASUMMIT_* (hard rule: docs/build/README.md "Hard rules").

# --- App ---
GAMMASUMMIT_ENV=
GAMMASUMMIT_LOG_LEVEL=
GAMMASUMMIT_CORS_ORIGINS=
GAMMASUMMIT_DATABASE_URL=

# --- DB pool (backend/core/db.py) ---
GAMMASUMMIT_DB_POOL_MIN_SIZE=
GAMMASUMMIT_DB_POOL_MAX_SIZE=
GAMMASUMMIT_DB_COMMAND_TIMEOUT_S=

# --- Unusual Whales (UW) data source (production source of truth) ---
GAMMASUMMIT_UW_URL=
GAMMASUMMIT_UW_SERVICE_KEY=
GAMMASUMMIT_UW_API_KEY=

# --- UW PHX fetchers (ingest daemon, E2.2) ---
GAMMASUMMIT_PHX_URL=
GAMMASUMMIT_PHX_AUTH_TOKEN=
GAMMASUMMIT_INGEST_PACE_S=
GAMMASUMMIT_INGEST_DAILY_CAP=
GAMMASUMMIT_INGEST_MAX_EXPIRIES=

# --- Tiering / retention (T0 24-48h raw, T3 cold root) ---
GAMMASUMMIT_T3_ROOT=
GAMMASUMMIT_RETENTION_RAW_HOURS=
GAMMASUMMIT_BACKFILL_MAX_ATTEMPTS=
GAMMASUMMIT_RETENTION_T2_DAYS=
GAMMASUMMIT_T3_RCLONE_REMOTE=
GAMMASUMMIT_T3_RCLONE_BUCKET=
GAMMASUMMIT_DB_OWNER_URL=

# --- Skylit API: TEMPORARY reverse-engineering tool only ---
# Subscription ends ~Nov 2026. Production must run UW-only.
GAMMASUMMIT_SKYLIT_API_KEY=

# --- Freshness metric + Uptime Kuma alarms (E2.4, docs/ops/operations.md) ---
GAMMASUMMIT_FRESHNESS_T0_STALE_MINUTES=
GAMMASUMMIT_FRESHNESS_DOWNSAMPLER_LAG_MINUTES=
GAMMASUMMIT_FRESHNESS_RETENTION_LATE_HOURS=
GAMMASUMMIT_HOT_SET_BUDGET_BYTES=
GAMMASUMMIT_KUMA_PUSH_OVERALL=
GAMMASUMMIT_KUMA_PUSH_T0_FRESHNESS=
GAMMASUMMIT_KUMA_PUSH_DOWNSAMPLER_LAG=
GAMMASUMMIT_KUMA_PUSH_RETENTION_JOBS=

# --- Feature flags (kill switches survive rollbacks) ---
GAMMASUMMIT_FF_ANALYST=
GAMMASUMMIT_FF_EXEC_GATE=
GAMMASUMMIT_FF_NEXUS=
